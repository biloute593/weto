{
  "expo": {
    "name": "Weto",
    "slug": "weto",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F2EE"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.weto.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F4F2EE"
      },
      "package": "com.weto.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "Weto",
      "shortName": "Weto",
      "description": "Weto est l'application de rencontre par dilemmes qui fait apparaître un vrai signal avant l'inscription."
    },
    "plugins": [],
    "extra": {
      "eas": {
        "projectId": "8e9c36d1-cb88-4a15-b3ed-2e6b441bcad2"
      }
    },
    "owner": "biloute593"
  }
}
